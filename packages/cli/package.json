{
  "name": "@plugload/cli",
  "version": "0.1.2",
  "description": "CLI for safe Payload CMS content operations through Plugload",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/owwix/plugload.git", "directory": "packages/cli" },
  "type": "module",
  "main": "./dist/index.js",
  "bin": { "plugload": "./dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=20.9.0" },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE"
  },
  "dependencies": {
    "@plugload/core": "workspace:*",
    "@plugload/mcp": "workspace:*"
  }
}
